title: ToDo forretningsgjennomgang
caption: ToDo gjennomgang

\whitespace trim

\procedure nhn-todo-row(svc)
<$let todo-member=<<svc>> currentTiddler=<<svc>>
	status={{{ [function[forms-todo-status]] }}}
	review={{{ [function[forms-todo-item]] }}}>
<tr>
<td><$link to=<<svc>>/></td>
<td><$text text={{{ [function[nhn-owner]] }}}/></td>
<td><span class={{{ [[$:/plugins/intertwingled-innovations/nhn/todo-status]get[text]jsonget<status>,[class]] }}}><$text text={{{ [[$:/plugins/intertwingled-innovations/nhn/todo-status]get[text]jsonget<status>,[label]] }}}/></span></td>
<td>
<% if [<review>!is[blank]] %>
<$link to=<<review>>>Åpne</$link>
<% else %>
<$button class="tc-btn-invisible nhn-todo-create">
<$action-setfield $tiddler="$:/state/nhn/form/review" $index="service" $value=<<svc>>/>
<$action-setfield $tiddler="$:/state/nhn/form/review" $index="year" $value=<<todo-year>>/>
<$action-setfield $tiddler="$:/state/nhn/form/review" $index="month" $value=<<todo-month>>/>
<$action-setfield $tiddler="$:/state/nhn/ny/form" text="$:/plugins/intertwingled-innovations/nhn/forms/review"/>
<$action-navigate $to="Ny"/>
{{$:/core/images/new-button}}&#32;Opprett
</$button>
<% endif %>
</td>
</tr>
</$let>
\end

! ToDo: forretningsgjennomgang

Tjenester som mangler månedens forretningsgjennomgang. «Kun mal» betyr at gjennomgangen finnes, men teksten er fortsatt malen — ingen har skrevet noe ennå.

<$let now-ord=<<now "0MM">> nhn-year-now=<<now "YYYY">>
	todo-attribution="nhn-review-service" todo-template={{{ [function[nhn-template-text]] }}}>
<$let now-month={{{ [function[nhn-form-months]] :filter[function[nhn-month-ord]compare:number:eq<now-ord>] }}}
	todo-year={{{ [[$:/state/nhn/todo/year]get[text]] :else[<nhn-year-now>] }}}
	todo-month={{{ [[$:/state/nhn/todo/month]get[text]] :else[<now-month>] }}}
	todo-scope={{{ [[$:/state/nhn/todo/scope]get[text]] :else[[aktive]] }}}>
<$let todo-ord={{{ [<todo-month>lowercase[]] :map[[$:/plugins/intertwingled-innovations/nhn/months]getindex<currentTiddler>] }}}>
<$let prevnum={{{ [<todo-ord>subtract[1]] }}}>
<$let todo-prev-month={{{ [function[nhn-form-months]] :filter[function[nhn-month-ord]compare:number:eq<prevnum>] :else[[Desember]] }}}
	todo-prev-year={{{ [<prevnum>compare:number:gt[0]then<todo-year>] :else[<todo-year>subtract[1]] }}}>
<$let todo-year-items={{{ [function[nhn-reviews]] :filter[function[nhn-year]match<todo-year>] +[format:titlelist[]join[ ]] }}}>
<$let todo-items={{{ [enlist<todo-year-items>] :filter[function[nhn-month]match<todo-month>] +[format:titlelist[]join[ ]] }}}
	todo-prior-items={{{ [function[nhn-reviews]] :filter[function[nhn-year]match<todo-prev-year>] :filter[function[nhn-month]match<todo-prev-month>] +[format:titlelist[]join[ ]] }}}
	reporting={{{ [function[forms-todo-covered-in],<todo-year-items>] +[format:titlelist[]join[ ]] }}}>
<$let raw-done={{{ [function[forms-todo-with-state],[done]] +[format:titlelist[]join[ ]] }}}
	raw-copy={{{ [function[forms-todo-with-state],[copy]] +[format:titlelist[]join[ ]] }}}
	raw-template={{{ [function[forms-todo-with-state],[template]] +[format:titlelist[]join[ ]] }}}>
<$let todo-set-done=<<raw-done>>
	todo-set-copy={{{ [enlist<raw-copy>] -[enlist<raw-done>] +[format:titlelist[]join[ ]] }}}
	todo-set-template={{{ [enlist<raw-template>] -[enlist<raw-done>] -[enlist<raw-copy>] +[format:titlelist[]join[ ]] }}}>
<$let svc-all={{{ [function[nhn-services]sort[title]] +[format:titlelist[]join[ ]] }}}
	svc-active={{{ [function[nhn-services]] :intersection[enlist<reporting>] +[sort[title]format:titlelist[]join[ ]] }}}>
<$let services={{{ [<todo-scope>match[alle]then<svc-all>else<svc-active>] }}}>

<div class="nhn-todo-controls">
<label>År:&#32;<$select tiddler="$:/state/nhn/todo/year" default=<<nhn-year-now>>>
<$list filter="[function[nhn-form-years]]"><option><$text text=<<currentTiddler>>/></option></$list>
</$select></label>
<label>Måned:&#32;<$select tiddler="$:/state/nhn/todo/month" default=<<now-month>>>
<$list filter="[function[nhn-form-months]]"><option><$text text=<<currentTiddler>>/></option></$list>
</$select></label>
<label>Omfang:&#32;<$select tiddler="$:/state/nhn/todo/scope" default="aktive">
<option value="aktive">Tjenester som rapporterer i <$text text=<<todo-year>>/></option>
<option value="alle">Alle tjenester</option>
</$select></label>
</div>

<$let n-total={{{ [enlist<services>count[]] }}}
	n-ok={{{ [enlist<services>] :intersection[enlist<todo-set-done>] +[count[]] }}}
	n-mal={{{ [enlist<services>] :intersection[enlist<todo-set-template>] +[count[]] }}}
	n-kopi={{{ [enlist<services>] :intersection[enlist<todo-set-copy>] +[count[]] }}}
	n-mangler={{{ [enlist<services>] -[function[forms-todo-covered]] +[count[]] }}}>
<div class="nhn-todo-summary">
<$text text=<<n-total>>/> tjenester ·
<span class="nhn-status-ok"><$text text=<<n-ok>>/> skrevet</span> ·
<span class="nhn-status-template"><$text text=<<n-mal>>/> kun mal</span> ·
<span class="nhn-status-copy"><$text text=<<n-kopi>>/> kopi</span> ·
<span class="nhn-status-missing"><$text text=<<n-mangler>>/> mangler</span>
</div>
</$let>

<% if [enlist<services>count[]match[0]] %>
<p class="nhn-todo-empty">Ingen tjenester i dette omfanget. Prøv «Alle tjenester», eller velg et annet år.</p>
<% else %>
<table class="nhn-todo-table">
<thead><tr><th>Tjeneste</th><th>Tjenesteeier</th><th>Status</th><th></th></tr></thead>
<tbody>
<$list filter="[enlist<services>]" variable="svc"><$transclude $variable="nhn-todo-row" svc=<<svc>>/></$list>
</tbody>
</table>
<% endif %>

<% if [function[nhn-services]] :filter[has[tjenesteeier]] :else[[none]] +[match[none]] %>
<p class="nhn-todo-hint">Ingen tjenester har tjenesteeier ennå, så eierkolonnen er tom. Sett eiere på [[Tjenesteeiere]].</p>
<% endif %>

</$let></$let></$let></$let></$let></$let></$let></$let></$let></$let></$let>
