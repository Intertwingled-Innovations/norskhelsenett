title: $:/plugins/intertwingled-innovations/nhn/forms/tjeneste
type: application/json
tags: $:/tags/nhn/Form
caption: Tjeneste

{
	"caption": "Tjeneste",
	"description": "En tjeneste i styringsstrukturen. Tjenestetype er Ekstern eller Intern; Kategori er valgfri og brukes for relaterte tjenester, satsinger for fart og oppgaver fra HOD. Sammen avgjør de hvilken styringstagg tjenestens forretningsgjennomganger får. Tjenesteeier brukes til gruppering og til ToDo-listene. År er valgfritt: flere eksisterende tjenester mangler årstag, og et påkrevd felt som dataene selv bryter ville blokkert redigering av dem.",
	"inputs": [
		{
			"name": "title",
			"label": "Tjenestenavn",
			"type": "text",
			"required": "yes",
			"from": "[<forms-target>]"
		},
		{
			"name": "unit",
			"label": "Forretningsområde",
			"type": "select",
			"options": "[tag[Divisjon]!tag[Domene]sort[title]]",
			"required": "yes",
			"from": "[<forms-target>] :map:flat[function[nhn-division]] +[first[]]"
		},
		{
			"name": "servicetype",
			"label": "Tjenestetype",
			"type": "select",
			"options": "[enlist<nhn-canonical-tjeneste-types>]",
			"required": "yes",
			"from": "[function[nhn-canonical-of],<forms-target>,<nhn-canonical-tjeneste-types>first[]]"
		},
		{
			"name": "category",
			"label": "Kategori",
			"type": "select",
			"options": "[enlist<nhn-secondary-tjeneste-types>]",
			"from": "[function[nhn-canonical-of],<forms-target>,<nhn-secondary-tjeneste-types>first[]]"
		},
		{
			"name": "serviceid",
			"label": "TjenesteID",
			"type": "number",
			"hint": "f.eks. 40031",
			"from": "[<forms-target>get[TjenesteID]]"
		},
		{
			"name": "owner",
			"label": "Tjenesteeier",
			"type": "text",
			"from": "[<forms-target>get[tjenesteeier]]"
		},
		{
			"name": "year",
			"label": "År",
			"type": "select",
			"options": "[function[nhn-form-years]]",
			"from": "[<forms-target>] :map:flat[function[nhn-year-raw]] +[first[]]"
		}
	],
	"title": "$:/plugins/intertwingled-innovations/nhn/forms/title-plain",
	"tags": "[<forms-state>getindex[unit]] [<forms-state>getindex[servicetype]] [<forms-state>getindex[category]] [<forms-state>getindex[year]]",
	"owns": "[enlist<nhn-extract-service-types>]",
	"fields": [
		{
			"name": "type",
			"filter": "[[text/vnd.tiddlywiki]]"
		},
		{
			"name": "TjenesteID",
			"filter": "[<forms-state>getindex[serviceid]]"
		},
		{
			"name": "tjenesteeier",
			"filter": "[<forms-state>getindex[owner]]"
		}
	]
}
