title: $:/plugins/intertwingled-innovations/nhn/styles
tags: $:/tags/Stylesheet
code-body: yes

.nhn-nav-menu {
	list-style: none;
	margin: 0 0 0.75em 0;
	padding: 0 0 0.5em 0;
	border-bottom: 1px solid <<colour tab-border>>;
}
.nhn-nav-menu li { margin: 0; padding: 0; }
.nhn-nav-menu a.tc-tiddlylink {
	display: flex;
	align-items: center;
	gap: 0.5em;
	padding: 0.35em 0.5em;
	border-radius: 4px;
	color: <<colour sidebar-tiddler-link-foreground>>;
}
.nhn-nav-menu a.tc-tiddlylink:hover {
	background: <<colour tab-background>>;
	text-decoration: none;
}
.nhn-nav-menu svg { width: 1.1em; height: 1.1em; flex: 0 0 auto; fill: <<colour muted-foreground>>; }

.nhn-extract-filters { margin: 0.75em 0; }

/* Coloured type-bar across the top edge of an application tiddler (kind → colour) */
.nhn-typebar {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 4px;
}

/* Service Owner (Tjenesteeier) capture */
.nhn-owner-field { margin: 0.4em 0 0.2em; }
.nhn-owner-label { font-weight: 600; margin-right: 0.4em; }
.nhn-owner-input {
	border: 1px solid <<colour tab-border>>;
	border-radius: 4px;
	padding: 2px 6px;
	min-width: 12em;
	font: inherit;
}
.nhn-owner-summary { color: <<colour muted-foreground>>; margin: 0.5em 0; }
.nhn-owner-table,
.nhn-anomaly-table { border-collapse: collapse; }
.nhn-anomaly-table th,
.nhn-anomaly-table td { border: 1px solid <<colour tab-border>>; padding: 3px 8px; text-align: left; }
.nhn-owner-table th,
.nhn-owner-table td { border: 1px solid <<colour tab-border>>; padding: 3px 8px; text-align: left; }

/* Guided creation (Ny) */
.nhn-form-picker { margin: 1em 0; }
.nhn-form-description { color: <<colour muted-foreground>>; font-style: italic; }
.nhn-edit-action { margin: 0.5em 0; }
.nhn-edit-button { color: <<colour muted-foreground>>; }
.nhn-edit-button svg { width: 1em; height: 1em; fill: <<colour muted-foreground>>; vertical-align: text-bottom; }
.nhn-edit-panel {
	margin: 1em 0;
	padding: 0.75em 1em;
	border: 1px solid <<colour muted-foreground>>;
	border-radius: 6px;
}

/* ToDo: forretningsgjennomgang */
.nhn-todo-controls { display: flex; flex-wrap: wrap; gap: 1.25em; align-items: center; margin: 1em 0 0.5em 0; }
.nhn-todo-summary { margin: 0.5em 0 1em 0; color: <<colour muted-foreground>>; }
.nhn-todo-summary span { white-space: nowrap; }
.nhn-todo-table { width: 100%; border-collapse: collapse; }
.nhn-todo-table th { text-align: left; }
.nhn-todo-table td, .nhn-todo-table th { padding: 0.3em 0.6em; border-bottom: 1px solid <<colour table-border>>; }
.nhn-todo-hint, .nhn-todo-empty { color: <<colour muted-foreground>>; font-style: italic; }
.nhn-todo-create svg,
.nhn-todo-open svg { width: 1em; height: 1em; fill: currentColor; vertical-align: text-bottom; }
.nhn-status-ok { color: #015945; }
.nhn-status-template { color: #e85800; }
.nhn-status-copy { color: #e85800; }
.nhn-status-missing { color: #6b1e27; font-weight: bold; }

/* Periodisering og arkiv */
.nhn-scope { margin: 0 0 0.75em 0; font-size: 0.9em; }
.nhn-arkiv-controls { margin: 1em 0; }
.nhn-arkiv-table { border-collapse: collapse; margin: 0.5em 0; }
.nhn-arkiv-table td, .nhn-arkiv-table th { padding: 0.2em 1.2em 0.2em 0; text-align: left; }
.nhn-arkiv-warning { color: #e85800; }
.nhn-arkiv-none { color: <<colour muted-foreground>>; font-style: italic; }
.nhn-arkiv-years { margin: 0.5em 0; }
.nhn-arkiv-restore { color: <<colour muted-foreground>>; text-decoration: underline; }

/* Anomalier: merging tag casing variants */
.nhn-tag-merge {
	margin: 1em 0;
	padding: 0.75em 1em;
	border: 1px solid <<colour tab-border>>;
	border-radius: 6px;
}
.nhn-tag-merge .nhn-anomaly-table { margin-bottom: 0.5em; }
.nhn-tag-merge-warning { color: #e85800; margin: 0.5em 0; }
.nhn-tag-merge-leftover { color: <<colour muted-foreground>>; margin: 0.5em 0; }

/* Leveranserapport (board delivery report) */
.nhn-rapport-controls { margin: 0.75em 0; display: flex; gap: 1em; flex-wrap: wrap; }
.nhn-rapport-summary {
	background: <<colour tab-background>>;
	border-left: 4px solid <<colour primary>>;
	padding: 0.5em 0.75em;
	margin: 0.75em 0;
}
.nhn-rapport-warning {
	background: #fff8e6;
	border-left: 4px solid #d9822b;
	padding: 0.5em 0.75em;
	margin: 0.75em 0;
}
.nhn-rapport-delivery {
	margin: 0 0 0.75em 0;
	padding: 0 0 0.75em 0;
	border-bottom: 1px solid <<colour tab-border>>;
}
.nhn-rapport-delivery-title { font-weight: 600; }
.nhn-rapport-description { margin: 0.25em 0; }
.nhn-rapport-description h1, .nhn-rapport-description h2, .nhn-rapport-description h3 {
	font-size: 1em;
	margin: 0.4em 0 0.1em 0;
}
.nhn-rapport-empty { color: <<colour muted-foreground>>; }
.nhn-rapport-tags { margin-top: 0.25em; }
.nhn-rapport-unlinked {
	background: #fff8e6;
	border-left: 4px solid #d9822b;
	padding: 0.75em;
	margin-top: 1.5em;
}

/* Anomalier: deleting leftover drafts */
.nhn-draft-purge {
	margin: 1em 0;
	padding: 0.75em 1em;
	border: 1px solid <<colour tab-border>>;
	border-radius: 6px;
}
.nhn-draft-purge-warning { color: #e85800; margin: 0.5em 0; }
.nhn-draft-purge-unsaved { color: <<colour muted-foreground>>; margin: 0.5em 0; }
