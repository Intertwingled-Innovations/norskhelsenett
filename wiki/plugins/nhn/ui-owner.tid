title: $:/plugins/intertwingled-innovations/nhn/ui/ViewTemplate/owner
tags: $:/tags/ViewTemplate
list-after: $:/core/ui/ViewTemplate/tags

\whitespace trim
<% if [<currentTiddler>function[nhn-kind]match[service]] %>
<div class="nhn-owner-field">
<span class="nhn-owner-label">Tjenesteeier:</span> <$edit-text tiddler=<<currentTiddler>> field=<<nhn-owner-field>> tag="input" default="" placeholder="(ingen tjenesteeier)" class="nhn-owner-input"/>
</div>
<div class="nhn-owner-field">
<span class="nhn-owner-label">Power BI:</span> <$edit-text tiddler=<<currentTiddler>> field=<<nhn-powerbi-field>> tag="input" default="" placeholder="https://app.powerbi.com/…" class="nhn-owner-input nhn-powerbi-input"/>
&#32;<$edit-text tiddler=<<currentTiddler>> field=<<nhn-powerbi-caption-field>> tag="input" default="" placeholder={{{ [function[nhn-powerbi-caption],<currentTiddler>] }}} class="nhn-owner-input"/>
<% if [function[nhn-powerbi-invalid],<currentTiddler>] %>
<div class="nhn-powerbi-warning">Ikke en Power BI-adresse. Den må begynne med `https://app.powerbi.com/` og kan ikke inneholde anførselstegn. Nye gjennomganger får ingen lenke før den er rettet.</div>
<% endif %>
</div>
<% endif %>
