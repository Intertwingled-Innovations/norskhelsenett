title: $:/plugins/intertwingled-innovations/nhn/rapport/styles
type: text/css
code-body: yes

body {
	font-family: Segoe UI, Arial, sans-serif;
	margin: 40px;
	line-height: 1.5;
	color: #222222;
	max-width: 60em;
}

h1 {
	border-bottom: 3px solid #005b9a;
	padding-bottom: 10px;
}

h2 {
	background-color: #f5f5f5;
	padding: 12px;
	border-left: 6px solid #005b9a;
	margin-top: 40px;
}

h2 a { color: #222222; text-decoration: none; }
h2 a:hover { text-decoration: underline; }

a.tc-tiddlylink { color: #005b9a; text-decoration: none; }
a.tc-tiddlylink:hover { text-decoration: underline; }

.summary {
	background-color: #f8f8f8;
	padding: 15px;
	margin-bottom: 25px;
	border-left: 6px solid #999999;
}

.toc {
	background-color: #eef5fb;
	padding: 15px;
	margin-bottom: 30px;
	border-left: 6px solid #005b9a;
}

.toc h2 { background-color: transparent; border-left: none; margin-top: 0; padding: 0; }
.toc ul { margin-top: 8px; }
.toc a { color: #005b9a; text-decoration: none; }
.toc a:hover { text-decoration: underline; }

.delivery {
	margin-left: 20px;
	margin-bottom: 20px;
	padding-bottom: 20px;
	border-bottom: 1px solid #cccccc;
}

.delivery-title { font-weight: bold; font-size: 1.05em; margin-bottom: 6px; }
.delivery-title a { color: #005b9a; text-decoration: none; }
.delivery-title a:hover { text-decoration: underline; }

.description { margin-top: 8px; }

/* Rendered delivery bodies may carry their own headings; keep them modest */
.description h1, .description h2, .description h3 {
	font-size: 1em;
	background: none;
	border: none;
	padding: 0;
	margin: 0.6em 0 0.2em 0;
}

.tags { color: #666666; font-size: 0.9em; margin-top: 8px; }
.tags a { color: #666666; }

.unlinked-section {
	background-color: #fff8e6;
	padding: 15px;
	margin-top: 40px;
	border-left: 6px solid #d9822b;
}

.back-to-top { font-size: 0.85em; margin-top: 10px; }
.back-to-top a { color: #666666; text-decoration: none; }
.back-to-top a:hover { text-decoration: underline; }
