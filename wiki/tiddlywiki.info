{
	"description": "NHN wiki \u2014 content and UI (client; static build target)",
	"themes": [
		"tiddlywiki/vanilla",
		"tiddlywiki/snowwhite"
	],
	"build": {
		"index": [
			"--rendertiddler",
			"$:/core/save/all",
			"index.html",
			"text/plain"
		],
		"plugins": [
			"--render",
			"[[$:/plugins/tiddlywiki/forms]]",
			"[[plugins/forms.json]]",
			"text/plain",
			"$:/core/templates/exporters/JsonFile",
			"exportFilter",
			"[[$:/plugins/tiddlywiki/forms]]",
			"--render",
			"[[$:/plugins/intertwingled-innovations/nhn]]",
			"[[plugins/nhn.json]]",
			"text/plain",
			"$:/core/templates/exporters/JsonFile",
			"exportFilter",
			"[[$:/plugins/intertwingled-innovations/nhn]]",
			"--render",
			"[[$:/plugins/intertwingled-innovations/nhn-theme]]",
			"[[plugins/nhn-theme.json]]",
			"text/plain",
			"$:/core/templates/exporters/JsonFile",
			"exportFilter",
			"[[$:/plugins/intertwingled-innovations/nhn-theme]]"
		]
	}
}
